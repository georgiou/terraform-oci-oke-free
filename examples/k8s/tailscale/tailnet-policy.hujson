// Merge into your tailnet policy file (Access controls → JSON editor).
{
  "tagOwners": {
    "tag:k8s-operator": [],                  // the OAuth client creates it
    "tag:k8s":          ["tag:k8s-operator"] // proxies the operator creates
  },

  "grants": [
    // kubectl via the API server proxy. In auth mode the proxy impersonates the
    // caller; this grant adds them to the "tailnet-admins" group (see rbac.yaml).
    {
      "src": ["autogroup:admin"],
      "dst": ["tag:k8s-operator"],
      "ip":  ["tcp:443"],
      "app": {
        "tailscale.com/cap/kubernetes": [
          { "impersonate": { "groups": ["tailnet-admins"] } }
        ]
      }
    },
    // Services exposed to the tailnet via loadBalancerClass: tailscale.
    {
      "src": ["autogroup:member"],
      "dst": ["tag:k8s"],
      "ip":  ["tcp:80", "tcp:443"]
    }
  ]
}
